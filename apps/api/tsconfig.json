{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false
  },
  "references": [{ "path": "../../packages/shared" }, { "path": "../../packages/database" }],
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "tests"]
}
