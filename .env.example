NODE_ENV=development

# Applications
API_PORT=3001
WORKER_HEALTH_PORT=3002
WORKER_CONCURRENCY=1
WORKER_LEASE_MS=60000
WORKER_CANCEL_POLL_MS=1000
WORKER_RECOVERY_INTERVAL_MS=30000
RUN_QUEUE_NAME=devflow-runs
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
CORS_ORIGINS=http://localhost:3000
# Parsed by the API, but currently does not control log output.
LOG_LEVEL=info
# Restrict LOCAL repository snapshots to this host directory when set.
DEVFLOW_LOCAL_REPOSITORY_ROOT=

# Development infrastructure
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow
POSTGRES_DB=devflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://devflow:devflow@localhost:5432/devflow?schema=public
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Default model transport, also used by the CLI. Supported providers: openai,
# openai-compatible. Stage bindings below inherit these values.
LLM_PROVIDER=openai-compatible
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=<api-key>
# Required for openai-compatible; optional custom endpoint for openai.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_PROVIDER_NAME=bailian
# auto enables strict JSON Schema for known-capable providers/models and falls
# back to JSON object mode elsewhere.
LLM_STRUCTURED_OUTPUT_MODE=json-object

# Run limits. Cost uses millionths of one chosen currency; all token rates use
# that currency. Configure every active provider:model before enabling the cap.
DEVFLOW_MAX_STEPS=32
DEVFLOW_MAX_COST_MICROS=
# JSON object keyed by the transport provider and model, for example
# openai-compatible:glm-5.3 (not the LLM_PROVIDER_NAME display label).
# Each value has inputMicrosPerMillionTokens and outputMicrosPerMillionTokens, and
# optionally cachedInputMicrosPerMillionTokens for provider prompt-cache hits
# (settlement only; pre-dispatch quotes stay at the uncached rate).
# No vendor prices are assumed; take them from your provider's price list, e.g.
# {"openai-compatible:glm-5.3":{"inputMicrosPerMillionTokens":8000000,"outputMicrosPerMillionTokens":28000000}}
DEVFLOW_MODEL_PRICES_JSON=
DEVFLOW_TIMEOUT_MS=1500000

# Autonomous solving: one agent with general tools solves the issue, the host
# re-runs the public checks, and failures return to the same session. The Run
# deadline (DEVFLOW_TIMEOUT_MS) and cost cap above apply across attempts.
DEVFLOW_AUTONOMOUS_MAX_TURNS=100
DEVFLOW_AUTONOMOUS_CONTEXT_TOKENS=100000
DEVFLOW_AUTONOMOUS_MAX_REVISIONS=2
DEVFLOW_AUTONOMOUS_CHECKPOINT_TURNS=5
DEVFLOW_AUTONOMOUS_MAX_ATTEMPTS=2
# Independent review. Tier 1: tool-free structured triage; tier 2: focused
# investigation of concrete concerns. Uses the REVIEW binding; these settings
# override its output/reasoning. Unsupported reasoning levels step down to the
# nearest one the model supports.
DEVFLOW_AUTONOMOUS_REVIEW=1
DEVFLOW_AUTONOMOUS_REVIEW_TOOL_TURNS=8
DEVFLOW_AUTONOMOUS_REVIEW_MAX_OUTPUT=4096
DEVFLOW_AUTONOMOUS_REVIEW_REASONING=medium
DEVFLOW_AUTONOMOUS_REVIEW_TRIAGE_REASONING=none
# Review and solver have separate cumulative cost slices: reserve and 1-reserve.
DEVFLOW_AUTONOMOUS_REVIEW_RESERVE=0.15

# Docker sandbox
DEVFLOW_SANDBOX_IMAGE=devflow-sandbox:local
DEVFLOW_SANDBOX_CPUS=2
DEVFLOW_SANDBOX_MEMORY_MB=2048
DEVFLOW_SANDBOX_PIDS=128
DEVFLOW_SANDBOX_NETWORK_ENABLED=false

# GitHub writes are platform-owned and disabled by default. Never expose
# GITHUB_TOKEN through NEXT_PUBLIC_*, Agent prompts, tools, or Sandbox env.
DEVFLOW_GITHUB_WRITE_ENABLED=false
GITHUB_TOKEN=
DEVFLOW_GITHUB_API_BASE_URL=https://api.github.com
DEVFLOW_GITHUB_WEB_BASE_URL=https://github.com

# Stage model bindings (Worker). EXECUTE is the solver, REVIEW the independent
# reviewer. Blank values inherit the default transport above; a different
# provider or endpoint needs its own API_KEY (credentials are not forwarded).
# MAX_OUTPUT_TOKENS includes thinking; CONTEXT_TOKENS is a host estimate cap.
LLM_EXECUTE_PROVIDER=
LLM_EXECUTE_MODEL=glm-5.3
LLM_EXECUTE_BASE_URL=
LLM_EXECUTE_API_KEY=
LLM_EXECUTE_PROVIDER_NAME=
LLM_EXECUTE_STRUCTURED_OUTPUT_MODE=json-object
LLM_EXECUTE_REASONING_EFFORT=low
LLM_EXECUTE_ENABLE_THINKING=true
LLM_EXECUTE_MAX_OUTPUT_TOKENS=8192
LLM_EXECUTE_CONTEXT_TOKENS=32000
LLM_REVIEW_PROVIDER=
LLM_REVIEW_MODEL=deepseek-v4-pro-0813
LLM_REVIEW_BASE_URL=
LLM_REVIEW_API_KEY=
LLM_REVIEW_PROVIDER_NAME=
LLM_REVIEW_STRUCTURED_OUTPUT_MODE=json-object
LLM_REVIEW_REASONING_EFFORT=high
LLM_REVIEW_ENABLE_THINKING=true
LLM_REVIEW_MAX_OUTPUT_TOKENS=16384
LLM_REVIEW_CONTEXT_TOKENS=64000
