NODE_ENV=development

# Applications
API_PORT=3001
WORKER_HEALTH_PORT=3002
WORKER_CONCURRENCY=1
WORKER_LEASE_MS=60000
WORKER_CANCEL_POLL_MS=1000
WORKER_RECOVERY_INTERVAL_MS=30000
RUN_QUEUE_NAME=devflow-runs
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
API_INTERNAL_BASE_URL=http://api:3001/api/v1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Restrict LOCAL repository snapshots to this host directory when set.
DEVFLOW_LOCAL_REPOSITORY_ROOT=

# Development infrastructure
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow
POSTGRES_DB=devflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://devflow:devflow@localhost:5432/devflow?schema=public
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Phase 1 CLI model. Supported providers: openai, openai-compatible.
LLM_PROVIDER=openai-compatible
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=<api-key>
# Required for openai-compatible; optional custom endpoint for openai.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_PROVIDER_NAME=bailian
# auto enables strict JSON Schema for known-capable providers/models and falls
# back to JSON object mode elsewhere.
LLM_STRUCTURED_OUTPUT_MODE=json-object
# efficient applies stage-specific reasoning settings; provider-default leaves
# the provider's reasoning behavior unchanged.
LLM_REASONING_PROFILE=efficient

# Phase 1 Agent limits
DEVFLOW_MAX_STEPS=25
DEVFLOW_MAX_RETRIES=2
# Leave model/tool overrides empty to derive budgets from each Run's maxSteps.
DEVFLOW_MAX_MODEL_CALLS=
DEVFLOW_MAX_TOOL_CALLS=
# Optional independent internal-execution/byte caps. Empty = observe without
# an additional cap; existing logical-tool and other Run limits still apply.
DEVFLOW_MAX_TOOL_EXECUTIONS=
DEVFLOW_MAX_IO_BYTES=
# Cost uses millionths of one chosen currency; all token rates use that currency.
# Configure every active provider:model before enabling this Run cost cap.
DEVFLOW_MAX_COST_MICROS=
# JSON object keyed by the transport provider and model, for example
# openai-compatible:glm-5.3 (not the LLM_PROVIDER_NAME display label).
# Each value has inputMicrosPerMillionTokens and outputMicrosPerMillionTokens.
# Missing prices remain UNPRICED; a cost cap rejects unpriced requests.
# See docs/resource-budget-scheduler.md. No vendor prices are assumed.
DEVFLOW_MODEL_PRICES_JSON=
DEVFLOW_MAX_TOTAL_TOKENS=250000
DEVFLOW_TIMEOUT_MS=1500000
DEVFLOW_REVIEW_REQUEST_TIMEOUT_MS=240000
DEVFLOW_REVIEW_RECOVERY_TIMEOUT_MS=210000
DEVFLOW_FINALIZE_TIMEOUT_MS=30000
DEVFLOW_STATE_DIR=.devflow/state
DEVFLOW_PREPATCH_EFFICIENCY_ENABLED=false
DEVFLOW_PREPATCH_CONTEXT_TOKEN_CAP=6000
# Production runs read-only Issue Localization Agent then the minimal proposal Planner.
# Retrieval remains their bounded tool; model/step/token limits remain Run-wide.
DEVFLOW_PLAN_AGENT_MAX_TOTAL_TOKENS=60000
DEVFLOW_PLAN_AGENT_MAX_MODEL_CALLS=2
DEVFLOW_PLAN_AGENT_TIMEOUT_MS=180000
DEVFLOW_LOCALIZATION_SMALL_REPO_FILES=64
DEVFLOW_LOCALIZATION_FAST_FILES=3
# Optional execution evidence policy; Agent planning is always active.
DEVFLOW_EVIDENCE_ACTION_ENABLED=false
DEVFLOW_EFFICIENCY_TRACE_ENABLED=false
# Phase-local exploration budgets within existing Run-wide limits.
DEVFLOW_EXPLORATION_READS=4
DEVFLOW_EXPLORATION_SEARCHES=2
DEVFLOW_EXPLORATION_RELOCATIONS=1
# Complete small targets use version-checked writeFile; 0 disables this preference.
DEVFLOW_WHOLE_FILE_WRITE_BYTES=4096

# Phase 1 Docker sandbox (network is always disabled for P1 runs)
DEVFLOW_SANDBOX_IMAGE=devflow-sandbox:local
DEVFLOW_SANDBOX_CPUS=2
DEVFLOW_SANDBOX_MEMORY_MB=2048
DEVFLOW_SANDBOX_PIDS=128
DEVFLOW_SANDBOX_NETWORK_ENABLED=false

# P10 GitHub writes are platform-owned and disabled by default. Never expose
# GITHUB_TOKEN through NEXT_PUBLIC_*, Agent prompts, tools, or Sandbox env.
DEVFLOW_GITHUB_WRITE_ENABLED=false
GITHUB_TOKEN=
DEVFLOW_GITHUB_API_BASE_URL=https://api.github.com
DEVFLOW_GITHUB_WEB_BASE_URL=https://github.com
# Phase 1.7: phase handoff only; never bypasses TEST, REVIEW or approval.
DEVFLOW_POST_PATCH_CONVERGENCE_ENABLED=false
# Legacy compatibility setting; a stable diff no longer auto-finishes Execute.
DEVFLOW_POST_PATCH_AUTOFINISH_ENABLED=false


# Stage model bindings (Worker). Blank values inherit the default/run binding.
# Default transport/API key: LLM_PROVIDER / LLM_BASE_URL / LLM_API_KEY.
# For a different provider or endpoint, set the stage API_KEY explicitly.
# MAX_OUTPUT_TOKENS includes thinking; CONTEXT_TOKENS is a host estimate cap.
# TEST and trusted evaluation remain deterministic. Unified Coding uses the
# EXECUTE binding for initial edits and every test/review failure iteration.
# REPAIR fields remain readable for historical configuration compatibility;
# they do not select a separate Agent/model in the unified Worker lifecycle.

LLM_LOCALIZATION_PROVIDER=
LLM_LOCALIZATION_MODEL=
LLM_LOCALIZATION_BASE_URL=
LLM_LOCALIZATION_API_KEY=
LLM_LOCALIZATION_PROVIDER_NAME=
LLM_LOCALIZATION_STRUCTURED_OUTPUT_MODE=json-object
# Localization uses bounded short decisions; users can opt into thinking with a suitable budget.
LLM_LOCALIZATION_REASONING_EFFORT=none
LLM_LOCALIZATION_ENABLE_THINKING=false
LLM_LOCALIZATION_MAX_OUTPUT_TOKENS=4096
LLM_LOCALIZATION_CONTEXT_TOKENS=32000
LLM_PLANNER_PROVIDER=
LLM_PLANNER_MODEL=deepseek-v4-pro-0813
LLM_PLANNER_BASE_URL=
LLM_PLANNER_API_KEY=
LLM_PLANNER_PROVIDER_NAME=
LLM_PLANNER_STRUCTURED_OUTPUT_MODE=json-object
LLM_PLANNER_REASONING_EFFORT=high
LLM_PLANNER_ENABLE_THINKING=true
LLM_PLANNER_MAX_OUTPUT_TOKENS=8192
LLM_PLANNER_CONTEXT_TOKENS=32000
LLM_EXECUTE_PROVIDER=
LLM_EXECUTE_MODEL=glm-5.3
LLM_EXECUTE_BASE_URL=
LLM_EXECUTE_API_KEY=
LLM_EXECUTE_PROVIDER_NAME=
LLM_EXECUTE_STRUCTURED_OUTPUT_MODE=json-object
LLM_EXECUTE_REASONING_EFFORT=low
LLM_EXECUTE_ENABLE_THINKING=true
LLM_EXECUTE_MAX_OUTPUT_TOKENS=8192
LLM_EXECUTE_CONTEXT_TOKENS=32000
# Legacy REPAIR binding: unused by the unified Coding Session. Configure its
# model, output and context through LLM_EXECUTE_* above.
LLM_REPAIR_PROVIDER=
LLM_REPAIR_MODEL=glm-5.3
LLM_REPAIR_BASE_URL=
LLM_REPAIR_API_KEY=
LLM_REPAIR_PROVIDER_NAME=
LLM_REPAIR_STRUCTURED_OUTPUT_MODE=json-object
LLM_REPAIR_REASONING_EFFORT=low
LLM_REPAIR_ENABLE_THINKING=true
LLM_REPAIR_MAX_OUTPUT_TOKENS=16384
LLM_REPAIR_CONTEXT_TOKENS=64000
LLM_REVIEW_PROVIDER=
LLM_REVIEW_MODEL=deepseek-v4-pro-0813
LLM_REVIEW_BASE_URL=
LLM_REVIEW_API_KEY=
LLM_REVIEW_PROVIDER_NAME=
LLM_REVIEW_STRUCTURED_OUTPUT_MODE=json-object
LLM_REVIEW_REASONING_EFFORT=high
# Review LENGTH recovery keeps thinking and uses low once; format conversion uses none.
LLM_REVIEW_ENABLE_THINKING=true
LLM_REVIEW_MAX_OUTPUT_TOKENS=16384
LLM_REVIEW_CONTEXT_TOKENS=64000
DEVFLOW_RELATION_GRAPH_ENABLED=true
DEVFLOW_CONTEXT_COMPRESSION_ENABLED=true
DEVFLOW_CONTEXT_COMPRESSION_MAX_CALLS=1
DEVFLOW_CONTEXT_COMPRESSION_MAX_INPUT_TOKENS=6000
DEVFLOW_CONTEXT_COMPRESSION_MAX_OUTPUT_TOKENS=2048
