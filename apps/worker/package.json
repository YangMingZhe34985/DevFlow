{
  "name": "@devflow/worker",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --enable-source-maps dist/main.js",
    "benchmark": "tsx src/benchmark-main.ts",
    "benchmark:efficiency": "tsx src/benchmark-main.ts --efficiency",
    "build": "tsc -b",
    "start": "node --enable-source-maps dist/main.js",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@devflow/agent": "2.3.1",
    "@devflow/database": "2.3.1",
    "@devflow/eval": "2.3.1",
    "@devflow/git": "2.3.1",
    "@devflow/github": "2.3.1",
    "@devflow/sandbox": "2.3.1",
    "@devflow/shared": "2.3.1",
    "@devflow/tools": "2.3.1",
    "@devflow/workflow": "2.3.1",
    "bullmq": "6.3.7",
    "dotenv": "18.0.0",
    "ioredis": "6.0.0",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  }
}
