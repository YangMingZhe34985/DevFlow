{
  "name": "devflow",
  "version": "0.1.0",
  "private": true,
  "description": "Observable and verifiable AI software engineering agent runs.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "postinstall": "npm run db:generate",
    "predev": "npm run build:core",
    "dev": "concurrently --kill-others-on-fail --names types,web,api,worker --prefix-colors yellow,cyan,green,magenta \"npm:dev:types\" \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:types": "tsc -b -w --preserveWatchOutput",
    "dev:web": "npm run dev --workspace @devflow/web",
    "dev:api": "npm run dev --workspace @devflow/api",
    "dev:worker": "npm run dev --workspace @devflow/worker",
    "dev:cli": "npm run dev --workspace @devflow/cli --",
    "acceptance:web": "node scripts/start-web-acceptance.mjs",
    "benchmark": "npm run benchmark --workspace @devflow/worker --",
    "benchmark:efficiency": "npm run benchmark:efficiency --workspace @devflow/worker --",
    "build": "npm run build:core && npm run build --workspace @devflow/web",
    "build:core": "tsc -b",
    "clean": "npm run clean --workspaces --if-present && rimraf coverage playwright-report test-results",
    "lint": "eslint . && npm run lint --workspace @devflow/web",
    "typecheck": "tsc -b && npm run typecheck --workspace @devflow/web",
    "test": "vitest run",
    "test:p1": "node scripts/run-p1-integration.mjs",
    "test:p2": "vitest run packages/agent/tests packages/tools/tests packages/workflow/tests apps/cli/tests",
    "test:p3": "node scripts/run-p3-integration.mjs",
    "test:p5": "node scripts/run-p5-integration.mjs",
    "test:p9": "node scripts/run-p9-integration.mjs",
    "test:p10": "node scripts/run-p10-integration.mjs",
    "test:p11": "node scripts/run-p11-integration.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "node scripts/build-web-e2e.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "npm run db:generate --workspace @devflow/database",
    "db:validate": "npm run db:validate --workspace @devflow/database",
    "db:format": "npm run db:format --workspace @devflow/database",
    "db:migrate": "npm run db:migrate --workspace @devflow/database",
    "db:migrate:deploy": "npm exec --workspace @devflow/database -- prisma migrate deploy",
    "db:studio": "npm run db:studio --workspace @devflow/database",
    "infra:up": "docker compose -f docker/compose.yml up -d",
    "infra:down": "docker compose -f docker/compose.yml down",
    "infra:logs": "docker compose -f docker/compose.yml logs -f",
    "sandbox:build": "docker build -f docker/sandbox/Dockerfile -t devflow-sandbox:local docker/sandbox"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.1",
    "concurrently": "^9.2.1",
    "eslint": "9.39.5",
    "prettier": "3.9.8",
    "rimraf": "6.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
