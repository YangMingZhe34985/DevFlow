{
  "name": "@devflow/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --enable-source-maps dist/main.js",
    "benchmark": "tsx src/benchmark-main.ts",
    "benchmark:efficiency": "tsx src/benchmark-main.ts --efficiency",
    "build": "tsc -b",
    "start": "node --enable-source-maps dist/main.js",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@devflow/agent": "0.1.0",
    "@devflow/database": "0.1.0",
    "@devflow/eval": "0.1.0",
    "@devflow/git": "0.1.0",
    "@devflow/github": "0.1.0",
    "@devflow/sandbox": "0.1.0",
    "@devflow/shared": "0.1.0",
    "@devflow/tools": "0.1.0",
    "@devflow/workflow": "0.1.0",
    "bullmq": "6.3.7",
    "dotenv": "18.0.0",
    "ioredis": "6.0.0",
    "zod": "4.6.5"
  }
}
